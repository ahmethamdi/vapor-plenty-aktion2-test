{
    "name": "VaporAktion2Test",
    "namespace": "VaporAktion2Test",
    "type": "integration",
    "version": "0.5.0",
    "description": "Aktion: Kaufe 6 Aktions-Artikel (ELFLIQ) und erhalte 1 ELFLIQ, 1 ELFX Pod Kit oder 1 ELFA Turbo Pod Kit gratis. Geschenk als echte Position zum Normalpreis + Aktionsgutschein (Festbetrag). Auswahl-Box im Warenkorb von plentyShop LTS.",
    "shortDescription": {
        "de": "Aktion: 6 ELFLIQ kaufen – 1 Geschenk gratis (Box im Warenkorb + Aktionsgutschein)",
        "en": "Promotion: buy 6 ELFLIQ – get 1 gift free (cart box + promotion coupon)"
    },
    "author": "34Devs",
    "email": "info@34devs.com",
    "authorIcon": "icon_author_xs.png",
    "pluginIcon": "icon_plugin_xs.png",
    "license": "proprietary",
    "isClosedSource": false,
    "keywords": [
        "basket",
        "gift",
        "zugabe",
        "coupon",
        "aktion"
    ],
    "require": {
        "IO": ">=5.0.0",
        "Ceres": ">=5.0.0"
    },
    "platform": {
        "php": ">=7.3 <8.5"
    },
    "serviceProvider": "VaporAktion2Test\\Providers\\VaporAktion2TestServiceProvider",
    "containers": [],
    "dataProviders": [
        {
            "key": "VaporAktion2Test\\Containers\\GeschenkScriptContainer",
            "name": "Aktion 2: Script (Pflicht)",
            "description": "Lädt JS/CSS der Geschenk-Box. Mit Ceres::Script.AfterScriptsLoaded verknüpfen.",
            "defaultLayoutContainer": "Ceres::Script.AfterScriptsLoaded"
        },
        {
            "key": "VaporAktion2Test\\Containers\\GeschenkBoxContainer",
            "name": "Aktion 2: Geschenk-Box Warenkorb",
            "description": "Geschenk-Auswahl auf der Warenkorb-Seite.",
            "defaultLayoutContainer": "Ceres::Basket.BeforeBasketTotals"
        },
        {
            "key": "VaporAktion2Test\\Containers\\GeschenkBoxVorschauContainer",
            "name": "Aktion 2: Geschenk-Box Warenkorb-Vorschau",
            "description": "Geschenk-Auswahl in der Warenkorb-Vorschau.",
            "defaultLayoutContainer": "Ceres::BasketPreview.BeforeBasketTotals"
        }
    ],
    "dependencies": [],
    "runOnBuild": []
}